[
  // Section A: Global pane navigation (ctrl+h/j/k/l)
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-shift-h": "pane::SplitLeft",
      "ctrl-shift-j": "pane::SplitDown",
      "ctrl-shift-k": "pane::SplitUp",
      "ctrl-shift-l": "pane::SplitRight",
    },
  },

  // Section F: AI assistant bindings
  {
    "context": "Workspace",
    "bindings": {
      "cmd-i": "assistant::InlineAssist",
      "cmd-l": "agent::ToggleFocus",
    },
  },

  // Section B: Space-leader normal mode bindings
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "space": null,
      "space ; ;": "editor::ToggleComments",
      "space '": "terminal_panel::Toggle",
      "space /": "project_search::ToggleFocus",
      "space tab": "tab_switcher::Toggle",
      "space 1": ["workspace::ActivatePane", 0],
      "space 2": ["workspace::ActivatePane", 1],
      "space 3": ["workspace::ActivatePane", 2],
      "space 4": ["workspace::ActivatePane", 3],
      "space 5": ["workspace::ActivatePane", 4],
      "space 6": ["workspace::ActivatePane", 5],
      "space 7": ["workspace::ActivatePane", 6],
      "space 8": ["workspace::ActivatePane", 7],
      "space b b": "tab_switcher::Toggle",
      "space b d": "pane::CloseActiveItem",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem",
      "space b s": "workspace::NewFile",
      "space e l": "diagnostics::Deploy",
      "space e n": "editor::GoToDiagnostic",
      "space e p": "editor::GoToPreviousDiagnostic",
      "space f f": "file_finder::Toggle",
      "space f r": "projects::OpenRecent",
      "space f s": "workspace::Save",
      "space f t": "project_panel::ToggleFocus",
      "space f y": "workspace::CopyPath",
      "space g b": "git::Branch",
      "space g c": "git::Commit",
      "space g f": "git::Fetch",
      "space g p": "git::Push",
      "space g s": "git_panel::ToggleFocus",
      "space g shift-s": "git::StageFile",
      "space g shift-u": "git::UnstageFile",
      "space h d": "zed::OpenKeymap",
      "space j =": "editor::Format",
      "space l l": "language_selector::Toggle",
      "space p f": "file_finder::Toggle",
      "space p p": "projects::OpenRecent",
      "space p t": "project_panel::ToggleFocus",
      "space q f": "zed::Quit",
      "space q q": "zed::Quit",
      "space s e": "editor::Rename",
      "space s j": "outline::Toggle",
      "space s p": "project_search::ToggleFocus",
      "space s shift-p": "project_search::ToggleFocus",
      "space shift-t shift-f": "zed::ToggleFullScreen",
      "space shift-t s": "theme_selector::Toggle",
      "space shift-t t": "workspace::ToggleLeftDock",
      "space t n": "workspace::NewTerminal",
      "space t t": "terminal_panel::Toggle",
      "space v": "editor::SelectLargerSyntaxNode",
      "space shift-v": "editor::SelectSmallerSyntaxNode",
      "space w -": "pane::SplitDown",
      "space w /": "pane::SplitRight",
      "space w d": "pane::CloseAllItems",
      "space w h": "workspace::ActivatePaneLeft",
      "space w shift-h": "workspace::SwapPaneLeft",
      "space w j": "workspace::ActivatePaneDown",
      "space w k": "workspace::ActivatePaneUp",
      "space w l": "workspace::ActivatePaneRight",
      "space w shift-l": "workspace::SwapPaneRight",
      "space w m": "workspace::ToggleZoom",
      "space w v": "pane::SplitRight",
      "space w w": "workspace::ActivatePaneRight",
      "space w shift-w": "workspace::ActivatePaneLeft",
      "space x s": "editor::SortLinesCaseSensitive",
    },
  },

  // Section C: Space-leader visual mode bindings
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "space": null,
      "space ; ;": "editor::ToggleComments",
      "space j =": "editor::Format",
      "space s l": "editor::SortLinesCaseInsensitive",
    },
  },

  // Section D: Project panel vim-style navigation
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "d": "project_panel::Trash",
      "r": "project_panel::Rename",
    },
  },
]
